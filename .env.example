# Preferred public prefix. Matching EVOAGENT_* names remain supported for upgrades.
DIFFPRISM_HOST=127.0.0.1
DIFFPRISM_PORT=8080
DIFFPRISM_DB_PATH=diffprism.db
DIFFPRISM_MAX_DIFF_BYTES=1048576
DIFFPRISM_MAX_STEPS=8
DIFFPRISM_TIMEOUT_SECONDS=120

# Login is disabled by default for local use. Enable it before exposing the service.
DIFFPRISM_AUTH_REQUIRED=false
DIFFPRISM_AUTH_SECRET=
DIFFPRISM_BOOTSTRAP_ADMIN_USERNAME=
DIFFPRISM_BOOTSTRAP_ADMIN_PASSWORD=
DIFFPRISM_DEFAULT_TENANT_ID=default
DIFFPRISM_SESSION_TTL_SECONDS=3600

# LLM provider: local | deepseek | openrouter-deepseek-free | openrouter-free | custom
# local keeps the deterministic rule-only reviewer.
DIFFPRISM_LLM_PROVIDER=local

DIFFPRISM_ENABLED_AGENTS=prism-lead,scope-mapper,failure-hunter,evidence-examiner
DIFFPRISM_AGENT_TOKEN_BUDGET=8000
DIFFPRISM_AGENT_TIME_BUDGET_SECONDS=60
# Preflight semantic context budget. Keep input + output below the model window.
DIFFPRISM_AGENT_CONTEXT_WINDOW_TOKENS=32768
DIFFPRISM_AGENT_CONTEXT_INPUT_TOKENS=20000
DIFFPRISM_CONTEXT_DIFF_TOKEN_BUDGET=12000
DIFFPRISM_CONTEXT_OBSERVATION_TOKEN_BUDGET=4000
DIFFPRISM_CONTEXT_RECENT_OBSERVATIONS=2
DIFFPRISM_CONTEXT_MAP_CHUNK_TOKENS=3000
# Configure current provider pricing for non-zero cost accounting in reports.
DIFFPRISM_LLM_INPUT_COST_PER_MILLION=0
DIFFPRISM_LLM_OUTPUT_COST_PER_MILLION=0

# Official DeepSeek (paid API; model defaults to deepseek-v4-flash)
DIFFPRISM_DEEPSEEK_API_KEY=

# OpenRouter free presets (API key required; low rate limits and availability may vary)
DIFFPRISM_OPENROUTER_API_KEY=
DIFFPRISM_OPENROUTER_SITE_URL=
DIFFPRISM_OPENROUTER_APP_NAME=DiffPrism

# Custom OpenAI-compatible Chat Completions endpoint (all three are required)
DIFFPRISM_LLM_BASE_URL=
DIFFPRISM_LLM_API_KEY=
DIFFPRISM_LLM_MODEL=

# Replay evaluation and evolution activation gate
DIFFPRISM_EVAL_MAX_CASES=5
DIFFPRISM_EVAL_MIN_CASES=3
DIFFPRISM_EVAL_MIN_HOLDOUT_CASES=2
DIFFPRISM_EVAL_MIN_IMPROVEMENT=0.01
DIFFPRISM_EVAL_MAX_METRIC_REGRESSION=0
DIFFPRISM_EVALUATION_MIN_PUBLIC_PRS=300
DIFFPRISM_EVALUATION_MIN_F1_IMPROVEMENT=0.03
DIFFPRISM_EVALUATION_MIN_HIGH_RISK_IMPROVEMENT=0.05

# GitHub integration
DIFFPRISM_GITHUB_WEBHOOK_SECRET=
DIFFPRISM_GITHUB_TOKEN=
DIFFPRISM_AUTO_POST_REVIEW=false
DIFFPRISM_WEBHOOK_MAX_AGE_SECONDS=600

# Production persistence and queue. Leave blank for SQLite/in-process mode.
DIFFPRISM_DATABASE_URL=
DIFFPRISM_REDIS_URL=
DIFFPRISM_ASYNC_WORKERS=2
DIFFPRISM_QUEUE_MAX_ATTEMPTS=3
DIFFPRISM_QUEUE_LEASE_SECONDS=60
DIFFPRISM_SKILLS_DIR=skills

# Repair verification and observability
DIFFPRISM_REPAIR_TEST_COMMAND=
DIFFPRISM_REPAIR_VERIFY_TIMEOUT_SECONDS=120
DIFFPRISM_MEMORY_ENABLED=true
DIFFPRISM_MEMORY_RECALL_LIMIT=6
DIFFPRISM_MEMORY_WORKING_TTL_SECONDS=86400
DIFFPRISM_OTEL_ENDPOINT=
DIFFPRISM_OTEL_SERVICE_NAME=diffprism
DIFFPRISM_ALERT_FAILURE_RATE=0.20
DIFFPRISM_ALERT_MIN_SAMPLES=10

# GitHub App (installation flow: /github/install, callback: /github/setup)
DIFFPRISM_GITHUB_APP_ID=
DIFFPRISM_GITHUB_APP_SLUG=
DIFFPRISM_GITHUB_PRIVATE_KEY_PATH=
DIFFPRISM_PUBLIC_BASE_URL=http://127.0.0.1:8080
