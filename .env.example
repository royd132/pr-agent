# TraceReview primary environment variables. Legacy EVOAGENT_* names remain supported.
TRACEREVIEW_HOST=127.0.0.1
TRACEREVIEW_PORT=8080
TRACEREVIEW_DB_PATH=tracereview.db
TRACEREVIEW_MAX_DIFF_BYTES=1048576
TRACEREVIEW_MAX_STEPS=8
TRACEREVIEW_TIMEOUT_SECONDS=120

# Login is disabled by default for local use. Enable it before exposing the service.
TRACEREVIEW_AUTH_REQUIRED=false
TRACEREVIEW_AUTH_SECRET=
TRACEREVIEW_BOOTSTRAP_ADMIN_USERNAME=
TRACEREVIEW_BOOTSTRAP_ADMIN_PASSWORD=
TRACEREVIEW_DEFAULT_TENANT_ID=default
TRACEREVIEW_SESSION_TTL_SECONDS=3600

# LLM provider: local | deepseek | openrouter-deepseek-free | openrouter-free | custom
# local keeps the deterministic rule-only reviewer.
TRACEREVIEW_LLM_PROVIDER=local

TRACEREVIEW_ENABLED_AGENTS=coordinator,boundary-inspector,behavior-inspector,evidence-auditor
TRACEREVIEW_AGENT_TOKEN_BUDGET=8000
TRACEREVIEW_AGENT_TIME_BUDGET_SECONDS=60
# Preflight semantic context budget. Keep input + output below the model window.
TRACEREVIEW_AGENT_CONTEXT_WINDOW_TOKENS=32768
TRACEREVIEW_AGENT_CONTEXT_INPUT_TOKENS=20000
TRACEREVIEW_CONTEXT_DIFF_TOKEN_BUDGET=12000
TRACEREVIEW_CONTEXT_OBSERVATION_TOKEN_BUDGET=4000
TRACEREVIEW_CONTEXT_RECENT_OBSERVATIONS=2
TRACEREVIEW_CONTEXT_MAP_CHUNK_TOKENS=3000
# Configure current provider pricing for non-zero cost accounting in reports.
TRACEREVIEW_LLM_INPUT_COST_PER_MILLION=0
TRACEREVIEW_LLM_OUTPUT_COST_PER_MILLION=0

# Official DeepSeek (paid API; model defaults to deepseek-v4-flash)
TRACEREVIEW_DEEPSEEK_API_KEY=

# OpenRouter free presets (API key required; low rate limits and availability may vary)
TRACEREVIEW_OPENROUTER_API_KEY=
TRACEREVIEW_OPENROUTER_SITE_URL=
TRACEREVIEW_OPENROUTER_APP_NAME=TraceReview

# Custom OpenAI-compatible Chat Completions endpoint (all three are required)
TRACEREVIEW_LLM_BASE_URL=
TRACEREVIEW_LLM_API_KEY=
TRACEREVIEW_LLM_MODEL=

# Replay evaluation and evolution activation gate
TRACEREVIEW_EVAL_MAX_CASES=5
TRACEREVIEW_EVAL_MIN_CASES=3
TRACEREVIEW_EVAL_MIN_HOLDOUT_CASES=2
TRACEREVIEW_EVAL_MIN_IMPROVEMENT=0.01
TRACEREVIEW_EVAL_MAX_METRIC_REGRESSION=0
TRACEREVIEW_EVALUATION_MIN_PUBLIC_PRS=300
TRACEREVIEW_EVALUATION_MIN_F1_IMPROVEMENT=0.03
TRACEREVIEW_EVALUATION_MIN_HIGH_RISK_IMPROVEMENT=0.05

# GitHub integration
TRACEREVIEW_GITHUB_WEBHOOK_SECRET=
TRACEREVIEW_GITHUB_TOKEN=
TRACEREVIEW_AUTO_POST_REVIEW=false
TRACEREVIEW_WEBHOOK_MAX_AGE_SECONDS=600

# Production persistence and queue. Leave blank for SQLite/in-process mode.
TRACEREVIEW_DATABASE_URL=
TRACEREVIEW_REDIS_URL=
TRACEREVIEW_ASYNC_WORKERS=2
TRACEREVIEW_QUEUE_MAX_ATTEMPTS=3
TRACEREVIEW_QUEUE_LEASE_SECONDS=60
TRACEREVIEW_SKILLS_DIR=skills

# Repair verification and observability
TRACEREVIEW_REPAIR_TEST_COMMAND=
TRACEREVIEW_REPAIR_VERIFY_TIMEOUT_SECONDS=120
TRACEREVIEW_MEMORY_ENABLED=true
TRACEREVIEW_MEMORY_RECALL_LIMIT=6
TRACEREVIEW_MEMORY_WORKING_TTL_SECONDS=86400
TRACEREVIEW_OTEL_ENDPOINT=
TRACEREVIEW_OTEL_SERVICE_NAME=tracereview
TRACEREVIEW_ALERT_FAILURE_RATE=0.20
TRACEREVIEW_ALERT_MIN_SAMPLES=10

# GitHub App (installation flow: /github/install, callback: /github/setup)
TRACEREVIEW_GITHUB_APP_ID=
TRACEREVIEW_GITHUB_APP_SLUG=
TRACEREVIEW_GITHUB_PRIVATE_KEY_PATH=
TRACEREVIEW_PUBLIC_BASE_URL=http://127.0.0.1:8080
